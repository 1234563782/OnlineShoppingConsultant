NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=public

NACOS_CLIENT_ENABLED=true
NACOS_REGISTER_ENABLED=true

SPRING_AI_DASHSCOPE_API_KEY=
SPRING_AI_DASHSCOPE_CHAT_MODEL=qwen-plus

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

SHOPPING_MEMORY_DB_URL=jdbc:mysql://localhost:3306/shopping_consultant?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SHOPPING_MEMORY_DB_USERNAME=root
SHOPPING_MEMORY_DB_PASSWORD=root

SHOPPING_CATALOG_BASE_URL=http://localhost:8083
SHOPPING_CATALOG_CONFIDENCE_THRESHOLD=0.85

# Optional: PostgreSQL + pgvector（商品语义索引，与 MySQL 商品库分离）
# 库名示例为 postgres；账号密码仅在本地/IDE 环境变量中配置，勿提交 .env
SHOPPING_VECTOR_JDBC_URL=jdbc:postgresql://localhost:5432/postgres
SHOPPING_VECTOR_DB_USERNAME=postgres
SHOPPING_VECTOR_DB_PASSWORD=
SHOPPING_VECTOR_EMBEDDING_MODEL=text-embedding-v2
# 须与 scripts/init-postgres-pgvector.sql 中 vector(n) 的 n 一致（text-embedding-v2 常见为 1536）
SHOPPING_VECTOR_EMBEDDING_DIMENSIONS=1536
# 为 true 且已配置 PG JDBC + SPRING_AI_DASHSCOPE_API_KEY 时启用商品向量检索；需先执行 scripts/init-postgres-pgvector.sql 并调用 rebuild 回填
SHOPPING_VECTOR_ENABLED=false
# 仅内网/开发：为 true 时 Catalog 暴露 POST /api/v1/catalog/product-embeddings/rebuild
SHOPPING_VECTOR_ADMIN_REBUILD_ENABLED=false
